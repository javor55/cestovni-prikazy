# Zkopírujte jako .env do kořene repozitáře a upravte.

# Doména, na které aplikace poběží (DNS záznam A musí mířit na tento server).
DOMAIN=cestovni-prikazy.example.cz

# Firemní síť bez veřejné domény: odkomentujte (viz deploy/Caddyfile.intranet).
# CADDYFILE=Caddyfile.intranet

# Počet dotazů na kurzy ČNB za minutu z jedné adresy.
# RATE_LIMIT_PER_MINUTE=60
